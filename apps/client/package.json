{
  "name": "@lapse/lapse-client",
  "version": "2.0.0",
  "description": "The canonical Lapse web client",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/generate-build-info.ts && next dev --webpack",
    "build": "tsx scripts/generate-build-info.ts && next build --webpack",

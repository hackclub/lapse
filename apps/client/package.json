    "@orpc/openapi": "^1.14.13",
    "@orpc/openapi-client": "^1.14.13",
    "@scure/bip39": "^2.2.0",
    "@squircle-js/react": "^1.3.0",
    "@types/platform": "^1.3.6",
    "@videojs/react": "10.0.0-beta.25",
    "clsx": "^2.1.1",
    "fetch-retry": "^6.0.0",

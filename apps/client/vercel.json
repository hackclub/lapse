{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && bash etc/fetch-lookout.sh && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && SOURCE_COMMIT=$VERCEL_GIT_COMMIT_SHA pnpm run build:client",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml"
}
